# ===== AfarRide server =====
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:4000

# ===== Chapa payment gateway (Telebirr, CBE Birr, cards) =====
# Get keys at https://dashboard.chapa.co — docs: https://developer.chapa.co
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1

# ===== Gemini AI Navigator (optional, from original AfarRide) =====
GEMINI_API_KEY=

# ===== Front-end apps (optional; defaults use the Vite dev proxy) =====
# VITE_API_URL=http://localhost:4000
